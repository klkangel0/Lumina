# Copie a .env y ajuste valores.

# Local (XAMPP): suele ser root sin contraseña → mysql://root@127.0.0.1:3306/NOMBRE_BD
# El NOMBRE_BD debe ser el mismo que usas con Prisma (donde exista la tabla User).
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/lumina_v2"
PORT=4001
JWT_SECRET=cambie_esto_por_un_secreto_largo

# Solo en producción (Plesk gassotea.org): NODE_ENV=production sirve React desde lumina-api/build.
# En local, aunque exista build/, no se sirve (evita login roto con bundle viejo).
# SERVE_REACT_BUILD=1

# Producción: orígenes permitidos (CORS). Varias URLs separadas por coma.
# CORS_ORIGIN=https://gassotea.org,https://www.gassotea.org

# Opcional: envío real de correos (recuperación de contraseña, avisos automáticos).
# Sin estas variables, los correos NO se envían: se registran en la consola del servidor API.
# El correo de salida de la entidad es info@assotea.cat (configura el usuario/contraseña SMTP de ese buzón).
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@assotea.cat
SMTP_PASS=contraseña_smtp
# Remitente por defecto. Si se omite, el código usa "Assotea <info@assotea.cat>".
SMTP_FROM="Assotea <info@assotea.cat>"
